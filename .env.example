# Application and local authentication
APP_NAME=Agentic Platform
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8000
AUTH_MODE=dev
API_BEARER_TOKEN=
API_KEY_SUBJECT=automation-client
API_KEY_ROLES=employee
API_KEY_SCOPES=knowledge:read,tasks:read,tasks:write
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
AGENT_IDENTITY_CLAIM=agentic_agent_id

# Secrets: direct environment values, env://NAME, or vault://path/to/item#key
SECRET_PROVIDER=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_KUBERNETES_ROLE=
VAULT_KUBERNETES_MOUNT=kubernetes
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_CACHE_TTL_SECONDS=60

# PostgreSQL and durable Valkey Streams outbox
POSTGRES_USER=agentic
POSTGRES_PASSWORD=change-this-local-password
COMPOSE_DATABASE_URL=postgresql+psycopg://agentic:change-this-local-password@postgres:5432/agentic
EVENT_WORKER_ENABLED=true
TASK_EXECUTION_MODE=queue
EVENT_CONSUMER_GROUP=agentic-workers
EVENT_CONSUMER_NAME=agentic-worker-1
EVENT_POLL_INTERVAL_SECONDS=1
DATA_SOURCE_SYNC_INTERVAL_SECONDS=

# OpenAI-compatible model, direct provider, or agentgateway
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MODEL_NAME=
MODEL_MAX_TOKENS=1200
MODEL_INPUT_COST_PER_MILLION=
MODEL_OUTPUT_COST_PER_MILLION=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AUDIT_ARCHIVE_BUCKET=
AUDIT_ARCHIVE_PREFIX=a2a/production/audit
AUDIT_ARCHIVE_REGION=us-east-1
AUDIT_ARCHIVE_RETENTION_DAYS=2557
AUDIT_ARCHIVE_KMS_KEY_ID=
OLLAMA_BASE_URL=http://ollama:11434/v1

# Vector embeddings; leave EMBEDDING_MODEL empty for deterministic local vectors
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Integrations. Values stay in the process environment, not SQL.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Outbound allowlist for production connector and source URLs
CONNECTOR_ALLOWED_HOSTS=
OPA_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional MQTT ingestion. Production requires mqtts:// with broker auth and CA trust.
MQTT_BROKER_URL=
MQTT_TOPIC_FILTER=a2a/telemetry/+/events
MQTT_CLIENT_ID=a2a-platform-ingress
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
MQTT_MAX_MESSAGE_BYTES=256000
