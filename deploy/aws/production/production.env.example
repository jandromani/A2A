# Copy to deploy/aws/production/production.env and chmod 600 before editing.
# The activation script reads this as data; it never executes it as shell code.
# AWS uses the named local profile/role. Long-lived AWS access keys do not belong here.
AWS_PROFILE=
AWS_REGION=us-east-1
PUBLIC_DOMAIN=agents.your-company.com
ROUTE53_ZONE_ID=Z_REPLACE_WITH_YOUR_PUBLIC_HOSTED_ZONE
CLUSTER_ADMIN_CIDRS=203.0.113.10/32
AUDIT_BUCKET_NAME=
BACKUP_BUCKET_NAME=

# Generate these with a password manager. They enter encrypted Terraform state.
DATABASE_ADMIN_PASSWORD=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
VALKEY_AUTH_TOKEN=REPLACE_WITH_40_OR_MORE_RANDOM_CHARACTERS

# Existing Keycloak instance and an existing human user to receive platform admin.
KEYCLOAK_URL=https://identity.your-company.com
KEYCLOAK_REALM=a2a
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_USERNAMES=your-existing-platform-admin
AGENT_CLIENT_IDS=a2a-agent-knowledge,a2a-agent-operations

# Vault KV v2 provisioner token; runtime workloads use Kubernetes auth instead.
VAULT_ADDR=https://vault.your-company.com
VAULT_NAMESPACE=
VAULT_KV_MOUNT=secret
VAULT_PROVISIONER_TOKEN=

# Model URL must expose OpenAI-compatible /chat/completions and /embeddings APIs.
# Langfuse keys must belong to the project at LANGFUSE_HOST.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CONNECTOR_ALLOWED_HOSTS=api.atlassian.com,api.github.com,oauth2.googleapis.com

# Optional connectors. Leave each integration's fields blank to keep it inactive.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional MQTT ingestion. When set, give mqtts://, credentials and a local CA file.
MQTT_BROKER_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
