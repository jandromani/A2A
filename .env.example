APP_NAME=Agentic Platform
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8000
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic-local-only
KEYCLOAK_ADMIN_PASSWORD=local-only-change-me

# Direct Uvicorn uses SQLite by default. Uncomment this to override it locally.
# DATABASE_URL=sqlite:///./data/agentic.db
# Compose uses PostgreSQL by default; set this to use another database there.
COMPOSE_DATABASE_URL=postgresql+psycopg://agentic:agentic-local-only@postgres:5432/agentic
REDIS_URL=
OPA_URL=
CONNECTOR_ALLOWED_HOSTS=

# dev is convenient for localhost only. Production must use api_key or oidc.
AUTH_MODE=dev
API_BEARER_TOKEN=
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# Optional hosted, OpenAI-compatible, or local model. Empty values are ignored.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=
MODEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MODEL_NAME=
MODEL_MAX_TOKENS=1200
MODEL_INPUT_COST_PER_MILLION=
MODEL_OUTPUT_COST_PER_MILLION=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional embeddings. Without an endpoint the platform uses local hashing and lexical search.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional Jira Cloud connector. Secrets are read only from environment variables.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
