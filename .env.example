APP_NAME=Agentic Platform
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8000
POSTGRES_USER=agentic
POSTGRES_PASSWORD=agentic-local-only
KEYCLOAK_ADMIN_PASSWORD=local-only-change-me

# Direct Uvicorn uses SQLite by default. Uncomment this to override it locally.
# DATABASE_URL=sqlite:///./data/agentic.db
# Compose uses PostgreSQL by default; set this to use another database there.
COMPOSE_DATABASE_URL=postgresql+psycopg://agentic:agentic-local-only@postgres:5432/agentic
REDIS_URL=
OPA_URL=
CONNECTOR_ALLOWED_HOSTS=

# dev is convenient for localhost only. Production must use api_key or oidc.
AUTH_MODE=dev
API_BEARER_TOKEN=
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# Optional OpenAI-compatible model and embedding endpoints. Without them, the
# system uses evidence-backed deterministic workflows and local lexical search.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional Jira Cloud connector. Secrets are read only from environment variables.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
